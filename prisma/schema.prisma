generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum LedgerType {
  ADMIN_GRANT
  USAGE_DEBIT
  MANUAL_ADJUSTMENT
}

enum UsageProvider {
  OPENAI
  XAI
}

enum UnitType {
  TOKENS_1K
  REQUEST
  IMAGE
  SECOND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  username            String                   @unique
  passwordHash        String?
  role                UserRole                 @default(USER)
  emailVerifiedAt     DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lastLoginAt         DateTime?
  authIdentities      AuthIdentity[]
  creditLedger        CreditLedger[]
  usageEvents         UsageEvent[]
  payments            Payment[]
  apiLogs             ApiLog[]
  verificationTokens  EmailVerificationToken[]
  createdPricingRules PricingSnapshot[]        @relation("PricingCreatedBy")
  createdAuditLogs    AuditLog[]               @relation("AuditActor")
  targetAuditLogs     AuditLog[]               @relation("AuditTarget")
}

model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model CreditLedger {
  id              String      @id @default(cuid())
  userId          String
  type            LedgerType
  amountCredits   Decimal     @db.Decimal(18, 4)
  balanceAfter    Decimal     @db.Decimal(18, 4)
  costUsd         Decimal?    @db.Decimal(18, 6)
  reason          String?
  metadata        Json?
  createdByUserId String?
  usageEventId    String?     @unique
  createdAt       DateTime    @default(now())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvent      UsageEvent? @relation(fields: [usageEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdByUserId, createdAt])
}

model UsageEvent {
  id                String          @id @default(cuid())
  userId            String
  provider          UsageProvider
  operation         String
  model             String?
  unitType          UnitType
  inputUnits        Decimal?        @db.Decimal(18, 6)
  outputUnits       Decimal?        @db.Decimal(18, 6)
  totalUnits        Decimal         @db.Decimal(18, 6)
  durationSeconds   Int?
  costUsd           Decimal         @db.Decimal(18, 6)
  creditsDeducted   Decimal         @db.Decimal(18, 4)
  requestId         String?
  pricingSnapshotId String?
  raw               Json?
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricingSnapshot   PricingSnapshot? @relation(fields: [pricingSnapshotId], references: [id], onDelete: SetNull)
  ledgerEntry       CreditLedger?

  @@index([userId, createdAt])
  @@index([provider, createdAt])
}

model PricingSnapshot {
  id               String        @id @default(cuid())
  provider         UsageProvider
  operation        String
  model            String?
  unitType         UnitType
  priceUsdPerUnit  Decimal       @db.Decimal(18, 8)
  creditsPerUsd    Decimal       @default(100) @db.Decimal(18, 4)
  effectiveFrom    DateTime      @default(now())
  effectiveTo      DateTime?
  isActive         Boolean       @default(true)
  createdByUserId  String?
  createdAt        DateTime      @default(now())
  createdBy        User?         @relation("PricingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  usageEvents      UsageEvent[]

  @@index([provider, operation, model, unitType, effectiveFrom])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amountUsd   Decimal       @db.Decimal(18, 6)
  credits     Decimal       @db.Decimal(18, 4)
  status      PaymentStatus @default(PENDING)
  providerRef String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiLog {
  id            String   @id @default(cuid())
  userId        String?
  method        String
  route         String
  statusCode    Int
  latencyMs     Int
  requestBytes  Int?
  responseBytes Int?
  errorMessage  String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([route, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  targetUserId  String?
  action        String
  payload       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  actorUser     User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser    User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}
